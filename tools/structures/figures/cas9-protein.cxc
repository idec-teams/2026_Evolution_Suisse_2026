# Cas9 protein from PDB 5F9R, author chain B (label chain A).
# Download 5F9R.cif into ../cache; ChimeraX resolves paths relative to this script.
# Site color tokens take precedence over the paper skill's palette.
open ../cache/5F9R.cif
delete #1 & ~(/B & protein)
show cartoons
color all #E0E0E0
graphics silhouettes color #3d3d3d width 1.5
hide atoms
graphics silhouettes true
lighting gentle
transparency 50
cartoon style xsection rectangle modeHelix default
color #1/B #999BCC target c
transparency #1 0 target c
set bgColor white
lighting depthCue false
graphics silhouettes width 0.7
view #1 orient
turn y -22
turn x 12
view #1 pad 0.08
